# External AI Services
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# Supabase Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Server and CORS
PORT=3000
CORS_ORIGIN=http://localhost:3000

# OpenClaw WS Configuration
USE_OPENCLAW=true
OPENCLAW_WS_URL=wss://openclaw-dev.braindcode.com
OPENCLAW_WS_TOKEN=your_openclaw_ws_token

# OpenClaw Internal Secret (For OpenClaw -> Express internal API)
INTERNAL_OPENCLAW_SECRET=your_internal_secret_here

# Legacy Configurations (Consider removing in prod)
N8N_WEBHOOK_BASE_URL=https://your-n8n.onrender.com
N8N_API_KEY=your-n8n-api-key
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
