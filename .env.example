# External AI Services
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# Supabase Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional fallback for offline JWT verify (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Server and CORS
PORT=3000
CORS_ORIGIN=http://localhost:8080
# Optional: development only — skips JWT when true (never enable in production)
# BYPASS_AUTH=false

# Redis (sessions)
REDIS_URL=redis://localhost:6379

# Encrypt OAuth / connection credentials at rest (falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
ENCRYPTION_SECRET=your_long_random_secret

# Optional JWT verify overrides
# JWT_AUDIENCE=authenticated
# JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Internal ingest (e.g. Twilio / meeting-bot webhooks)
# INTERNAL_INGEST_SECRET=your_ingest_secret

# Optional Telegram env fallback (prefer per-user Settings → Integrations)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional multi-provider LLM/STT fallbacks
# OPENAI_API_KEY=
# CLAUDE_API_KEY=
# DEEPGRAM_API_KEY=

# Optional CRM test overrides (dev)
# RAPIDOCRM_TEST_TOKEN=
# RAPIDOCRM_API_URL=

# Optional skills directory override
# SKILLS_DIR=

# Set true to log non-sensitive key-resolution summaries
# LOG_KEY_RESOLUTION=false

# OpenClaw WS Configuration
USE_OPENCLAW=true
OPENCLAW_WS_URL=wss://openclaw-dev.braindcode.com
OPENCLAW_WS_TOKEN=your_openclaw_ws_token

# OpenClaw Internal Secret (For OpenClaw -> Express internal API)
INTERNAL_OPENCLAW_SECRET=your_internal_secret_here

# RapidoCRM OAuth2 (PKCE public client — client_secret optional)
# Register an OAuth app in RapidoCRM admin — do NOT use a placeholder like "41"
RAPIDOCRM_CLIENT_ID=your_client_id_from_dynamic_registration
# Leave empty for PKCE-only public client (no secret issued)
RAPIDOCRM_CLIENT_SECRET=
RAPIDOCRM_AUTH_URL=https://crm.rapidosoftware.com/oauth/authorize
RAPIDOCRM_TOKEN_URL=https://crm.rapidosoftware.com/oauth/token
RAPIDOCRM_MCP_URL=https://crm.rapidosoftware.com/mcp
RAPIDOCRM_REDIRECT_URI=http://localhost:3000/auth/crm/callback
RAPIDOCRM_SCOPE=mcp:use
FRONTEND_URL=http://localhost:8080

# RapidoCMS OAuth2 (PKCE public client — client_secret optional)
# Register an OAuth app in RapidoCMS admin — do NOT use a placeholder like "42"
RAPIDOCMS_CLIENT_ID=your_client_id_from_dynamic_registration
RAPIDOCMS_CLIENT_SECRET=
RAPIDOCMS_AUTH_URL=https://cms.rapidosoftware.com/oauth/authorize
RAPIDOCMS_TOKEN_URL=https://cms.rapidosoftware.com/oauth/token
RAPIDOCMS_MCP_URL=https://cms.rapidosoftware.com/mcp
RAPIDOCMS_REDIRECT_URI=http://localhost:3000/auth/cms/callback
RAPIDOCMS_SCOPE=mcp:use
# After connect: CMS_USER_ID=<uuid> npm run list-cms-tools
# Or: RAPIDOCMS_ACCESS_TOKEN=<token> npm run list-cms-tools

# Rapido RH OAuth2 (authorization code + PKCE; public client — auth method none)
RAPIDORH_CLIENT_ID=your_client_id_from_dynamic_registration
RAPIDORH_CLIENT_SECRET=
RAPIDORH_AUTH_URL=https://rh.rapidosoftware.com/oauth/authorize
RAPIDORH_TOKEN_URL=https://rh.rapidosoftware.com/oauth/token
RAPIDORH_MCP_URL=https://rh.rapidosoftware.com/mcp
RAPIDORH_REDIRECT_URI=http://localhost:3000/auth/rh/callback
RAPIDORH_SCOPE=mcp:use
# After connect: RH_USER_ID=<uuid> npm run list-rh-tools
# Or: RAPIDORH_ACCESS_TOKEN=<token> npm run list-rh-tools

# Google Calendar OAuth2 (Web Application credential from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar openid email profile
# Optional IANA timezone for events created from date+time params (default UTC)
GOOGLE_CALENDAR_TIMEZONE=Europe/Paris

# n8n MCP hub (calendar, email, telegram — not CRM)
MCP_N8N_URL=https://your-n8n.example.com/mcp/your-endpoint-id
N8N_API_KEY=your-n8n-api-key
